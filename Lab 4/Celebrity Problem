#include <stdio.h>
#include <stdlib.h>

int celeb(int n , int cel[n][n])
{
    int candidate = 0;
    for (int i = 1; i < n; i++)
    {
        if (cel[candidate][i]==1)
        {
            candidate = i;
        }
    }

    for (int i = 0; i < n; i++)
    {
        if (cel[candidate][i] == 1 ||
            (i != candidate && cel[i][candidate] == 0))
        {
            return -1;
        }
    }
    return candidate;

}

int main()
{
    int n;
    printf("enter number of people : ");
    scanf("%d", &n);
    int M[n][n];
    printf("enter the matrix: \n");
    for (int i = 0; i < n; i++)
    {
        for(int j = 0; j < n; j++)
        {
            scanf("%d", &M[i][j]);
        }
    }
    int c = celeb(n,M);
    if (c == -1)
    {
        printf("No celebrity here ): ");
    }
    else
    {
        printf("the person found is celebrity = %d \n ", c );
    }
    return 0;
}
