#include <stdio.h>
#include <stdlib.h>

int compare(const void *a, const void *b) {
    int x = *(int *)a;
    int y = *(int *)b;

    return (x > y) - (x < y);
}

int main() {

    int arr[] = {3, 2, 1, 5, 6, 4};
    int n = 6;
    int k = 2;

    qsort(arr, n, sizeof(int), compare);

    printf("Kth largest element = %d", arr[n-k]);

    return 0;
}

