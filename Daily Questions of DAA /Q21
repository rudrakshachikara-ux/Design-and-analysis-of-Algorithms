#include <stdio.h>

int partition(int arr[], int low, int high) {

    int pivot = arr[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {

        if (arr[j] <= pivot) {
            i++;

            int temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
        }
    }

    int temp = arr[i + 1];
    arr[i + 1] = arr[high];
    arr[high] = temp;

    return i + 1;
}

int quickSelect(int arr[], int low, int high, int target) {

    while (low <= high) {

        int pivotIndex = partition(arr, low, high);

        if (pivotIndex == target) {
            return arr[pivotIndex];
        }

        else if (pivotIndex < target) {
            low = pivotIndex + 1;
        }

        else {
            high = pivotIndex - 1;
        }
    }

    return -1;
}

int main() {

    int arr[] = {3, 2, 1, 5, 6, 4};

    int n = 6;
    int k = 2;

    if (k < 1 || k > n) {
        printf("Invalid value of k");
        return 0;
    }

    int result = quickSelect(arr, 0, n - 1, n - k);

    printf("Kth largest element = %d", result);

    return 0;
}
