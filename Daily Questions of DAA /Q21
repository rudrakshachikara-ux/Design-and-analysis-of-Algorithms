#include <stdio.h>

int main() {

    int arr[] = {3, 2, 1, 5, 6, 4};
    int n = 6;
    int k = 2;

    for (int i = 0; i < k; i++) {

        int maxIndex = i;

        for (int j = i + 1; j < n; j++) {

            if (arr[j] > arr[maxIndex]) {
                maxIndex = j;
            }
        }

        // Swap maximum element
        int temp = arr[i];
        arr[i] = arr[maxIndex];
        arr[maxIndex] = temp;
    }

    printf("Kth largest element = %d", arr[k-1]);

    return 0;
}
