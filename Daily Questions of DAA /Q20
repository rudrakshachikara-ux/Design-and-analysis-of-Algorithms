#include <stdio.h>
#include <string.h>

int main() {

    char s[1000];

    printf("Enter a string: ");
    scanf("%999s", s);

    int last[256];

    // Initialize all positions to -1
    for (int i = 0; i < 256; i++) {
        last[i] = -1;
    }

    int start = 0;
    int maxLen = 0;
    int maxStart = 0;

    for (int i = 0; s[i] != '\0'; i++) {

        unsigned char ch = s[i];

        // Check for repeated character
        if (last[ch] >= start) {
            start = last[ch] + 1;
        }

        // Update last occurrence
        last[ch] = i;

        // Calculate current substring length
        int len = i - start + 1;

        // Update longest substring
        if (len > maxLen) {
            maxLen = len;
            maxStart = start;
        }
    }

    printf("Longest substring: ");

    for (int i = maxStart; i < maxStart + maxLen; i++) {
        printf("%c", s[i]);
    }

    printf("\nLength: %d", maxLen);

    return 0;
}
