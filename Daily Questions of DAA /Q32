#include <stdio.h>

int main() {
    int a[] = {2, 0, 3, -2, -1, 0, 1};
    int n = 7;

    printf("Triplets whose sum is 0:\n");

    for (int i = 0; i < n - 2; i++) {
        for (int j = i + 1; j < n - 1; j++) {
            for (int k = j + 1; k < n; k++) {

                if (a[i] + a[j] + a[k] == 0) {
                    printf("%d %d %d\n", a[i], a[j], a[k]);
                }

            }
        }
    }

    return 0;
}
