#include <stdio.h>

int main() {
    int n, digit, sum = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    while (n > 0) {
        digit = n % 10;
        sum += digit;
        n /= 10;
    }

    // Sum of digits 0 to 9 = 45
    printf("Missing digit: %d\n", 45 - sum);

    return 0;
}
