#include <stdio.h>

int main() {
    int n, i;
    int current = 1, longest = 1;

    printf("Enter number of days: ");
    scanf("%d", &n);

    int temp[n];

    printf("Enter temperatures: ");
    for (i = 0; i < n; i++) {
        scanf("%d", &temp[i]);
    }

    for (i = 1; i < n; i++) {
        if (temp[i] > temp[i - 1]) {
            current++;
        } else {
            current = 1;
        }

        if (current > longest) {
            longest = current;
        }
    }

    printf("Longest increasing streak: %d\n", longest);

    return 0;
}
