#include <stdio.h>

int main() {
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter sorted array elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int j = 1;

    // Remove duplicates
    for (int i = 1; i < n; i++) {
        if (arr[i] != arr[i - 1]) {
            arr[j] = arr[i];
            j++;
        }
    }

    printf("Array after removing duplicates: ");

    for (int i = 0; i < j; i++) {
        printf("%d ", arr[i]);
    }

    printf("\nNumber of unique elements: %d\n", j);

    return 0;
}
