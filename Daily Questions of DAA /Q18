#include <stdio.h>

int main() {

    int arr[] = {1, 1, 2, 3, 3, 3, 4};
    int n = sizeof(arr) / sizeof(arr[0]);

    int j = 0;

    for (int i = 1; i < n; i++) {

        if (arr[i] != arr[j]) {
            j++;
            arr[j] = arr[i];
        }
    }

    int k = j + 1;

    printf("Unique elements: ");

    for (int i = 0; i < k; i++) {
        printf("%d ", arr[i]);
    }

    printf("\nNumber of unique elements: %d", k);

    return 0;
}
