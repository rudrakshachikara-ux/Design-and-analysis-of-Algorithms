#include <stdio.h>

int main() {
    int n, temp;
    int ones = 0, zeros = 0;
    int currentOnes = 0, maxOnes = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    // Special case for 0
    if (temp == 0) {
        zeros = 1;
    }

    while (temp > 0) {
        if (temp % 2 == 1) {
            ones++;
            currentOnes++;

            if (currentOnes > maxOnes) {
                maxOnes = currentOnes;
            }
        } else {
            zeros++;
            currentOnes = 0;
        }

        temp = temp / 2;
    }

    printf("Number of 1s: %d\n", ones);
    printf("Number of 0s: %d\n", zeros);
    printf("Consecutive 1s: %d\n", maxOnes);

    return 0;
}
