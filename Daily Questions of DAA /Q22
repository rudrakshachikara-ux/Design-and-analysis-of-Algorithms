#include <stdio.h>

int main() {

    int arr[] = {0, 1, 0, 3, 12};
    int n = 5;

    int temp[n];
    int j = 0;

    // Store all non-zero elements
    for (int i = 0; i < n; i++) {

        if (arr[i] != 0) {
            temp[j] = arr[i];
            j++;
        }
    }

    // Add zeros at the end
    while (j < n) {
        temp[j] = 0;
        j++;
    }

    // Copy back to original array
    for (int i = 0; i < n; i++) {
        arr[i] = temp[i];
    }

    printf("Array after shifting zeros: ");

    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}

/*Optimal Approach – Two Pointer Technique*/


#include <stdio.h>

int main() {

    int arr[] = {0, 1, 0, 3, 12};
    int n = 5;

    int j = 0;

    for (int i = 0; i < n; i++) {

        if (arr[i] != 0) {

            int temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;

            j++;
        }
    }

    printf("Array after shifting zeros: ");

    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
