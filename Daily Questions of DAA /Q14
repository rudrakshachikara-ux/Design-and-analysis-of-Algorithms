#include <stdio.h>
#include <stdlib.h>

int main() {
    int m, n;

    printf("Enter size of arr1: ");
    scanf("%d", &m);

    int arr1[m];

    printf("Enter elements of arr1: ");
    for (int i = 0; i < m; i++) {
        scanf("%d", &arr1[i]);
    }

    printf("Enter size of arr2: ");
    scanf("%d", &n);

    int arr2[n];

    printf("Enter elements of arr2: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr2[i]);
    }

    int minDiff = abs(arr1[0] - arr2[0]);

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {

            int diff = abs(arr1[i] - arr2[j]);

            if (diff < minDiff) {
                minDiff = diff;
            }
        }
    }

    printf("Smallest difference = %d\n", minDiff);

    return 0;
}
