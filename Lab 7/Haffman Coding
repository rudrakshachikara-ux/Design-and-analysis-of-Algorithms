#include <stdio.h>

struct Node {
    char ch;
    int freq;
};

int main() {
    struct Node a[20];
    int n, i, j;

    printf("Enter number of characters: ");
    scanf("%d", &n);

    printf("Enter character and frequency:\n");

    for(i = 0; i < n; i++) {
        scanf(" %c %d", &a[i].ch, &a[i].freq);
    }

    // Sort characters according to frequency
    for(i = 0; i < n - 1; i++) {
        for(j = i + 1; j < n; j++) {

            if(a[i].freq > a[j].freq) {
                struct Node temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }

    printf("\nHuffman Codes:\n");

    // Simple prefix codes
    for(i = 0; i < n; i++) {

        printf("%c = ", a[i].ch);

        for(j = 0; j < i; j++) {
            printf("1");
        }

        if(i != n - 1)
            printf("0");

        printf("\n");
    }

    return 0;
}
